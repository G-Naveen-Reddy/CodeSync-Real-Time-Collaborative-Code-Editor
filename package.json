{
  "name": "codesync-editor",
  "version": "1.0.0",
  "private": true,
  "description": "CodeSync - Real-Time Collaborative Code Editor",
  "scripts": {
    "install:all": "cd frontend && npm install",
    "dev:backend": "cd backend && mvn spring-boot:run",
    "dev:frontend": "cd frontend && npm start",
    "dev:all": "concurrently --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev:all",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && mvn package -DskipTests",
    "build:all": "npm run build:backend && npm run build:frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
